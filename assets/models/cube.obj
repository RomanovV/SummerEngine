# Unit cube centered at origin, 2x2x2 units (matches common sandbox scale).
# Wavefront OBJ — no material file needed for Step 6.

o Cube

v -1.0 -1.0 -1.0
v  1.0 -1.0 -1.0
v  1.0  1.0 -1.0
v -1.0  1.0 -1.0
v -1.0 -1.0  1.0
v  1.0 -1.0  1.0
v  1.0  1.0  1.0
v -1.0  1.0  1.0

vn  0.0  0.0 -1.0
vn  0.0  0.0  1.0
vn  0.0 -1.0  0.0
vn  0.0  1.0  0.0
vn -1.0  0.0  0.0
vn  1.0  0.0  0.0

vt  0.0 0.0
vt  1.0 0.0
vt  1.0 1.0
vt  0.0 1.0

# Back face
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
# Front face
f 5/1/2 6/2/2 7/3/2
f 5/1/2 7/3/2 8/4/2
# Bottom face
f 1/1/3 5/2/3 6/3/3
f 1/1/3 6/3/3 2/4/3
# Top face
f 4/1/4 3/2/4 7/3/4
f 4/1/4 7/3/4 8/4/4
# Left face
f 1/1/5 4/2/5 8/3/5
f 1/1/5 8/3/5 5/4/5
# Right face
f 2/1/6 6/2/6 7/3/6
f 2/1/6 7/3/6 3/4/6
